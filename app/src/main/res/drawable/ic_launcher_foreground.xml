<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground layer of the adaptive icon. Two rules govern what is safe to draw here:

  The layer is 108x108dp but a launcher mask may crop anything outside the central 72x72dp, and
  it shifts the layers apart for parallax. The artwork was drawn 76dp wide, so its edges were
  being clipped; the group below scales it into the safe area around the same centre.

  It also must not paint its own background. The solid 108x108 rectangle that used to sit here
  duplicated <background> and showed up as a square corner whenever the mask was not a square.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.72"
        android:scaleY="0.72">
        <path android:fillColor="#65D6AD" android:pathData="M25,30h58c5,0 9,4 9,9v30c0,5 -4,9 -9,9h-58c-5,0 -9,-4 -9,-9v-30c0,-5 4,-9 9,-9z" />
        <path android:fillColor="#111820" android:pathData="M31,43l13,11 -13,11v-7l6,-4 -6,-4zM49,62h25v6h-25z" />
    </group>
</vector>
