<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed to hand a downloaded APK to the package installer. The system still shows its own
         confirmation dialog; this only allows PocketSSH to be the source of the request. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Declared signature-level by the recovery helper, so this is only granted because both
         APKs are signed with the same key. -->
    <uses-permission android:name="com.pocketssh.recovery.PERFORM_ROLLBACK" />
    <!-- Needed on Android 11+ to detect the recovery helper and start it; without this the
         package is invisible no matter that it is installed. -->
    <queries>
        <package android:name="com.pocketssh.recovery" />
    </queries>

    <application
        android:name=".PocketSshApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="PocketSSH"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketSSH">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives PackageInstaller session results, including the request to show Android's
             own install confirmation. Not exported: only the system posts to it. -->
        <receiver
            android:name=".update.InstallStatusReceiver"
            android:exported="false" />

        <!-- Grants the package installer read access to the downloaded APK, which lives in the
             app's own cache and is otherwise unreadable by another process. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
